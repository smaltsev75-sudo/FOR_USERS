{
    "name": "sprint-planner",
    "version": "1.0.0",
    "description": "Инструмент для планирования спринтов на основе формализованных критериев",
    "private": true,
    "scripts": {
        "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config=jest.config.cjs",
        "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage --config=jest.config.cjs",
        "test:smoke": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config=jest.config.cjs --runInBand --runTestsByPath tests/unit/app.integration.test.js tests/unit/controllers/configController.test.js tests/unit/controllers/roleController.test.js tests/unit/controllers/keyboardController.test.js tests/unit/controllers/selection/selectionHelpers.test.js",
        "test:e2e": "npx playwright test",
        "test:e2e:ui": "npx playwright test --ui",
        "lint": "eslint js/ sw.js",
        "lint:fix": "eslint js/ sw.js --fix"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.1",
        "@babel/core": "^7.29.0",
        "@babel/plugin-transform-modules-commonjs": "^7.28.6",
        "@babel/preset-env": "^7.29.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.58.2",
        "babel-jest": "^29.7.0",
        "babel-plugin-istanbul": "^6.1.1",
        "c8": "^10.1.3",
        "dompurify": "^3.3.1",
        "eslint": "^10.0.2",
        "globals": "^17.3.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.2.0"
    },
    "type": "module"
}